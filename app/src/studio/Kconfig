# AuroraKey live-USB mutation extensions. Each is opt-in so an upstream
# ZMK build that doesn't pull these in stays the same byte-for-byte. The
# proto wire IDs are 100..199 (reserved range in behaviors.proto) so an
# editor that doesn't understand them silently rejects unknown oneofs.

menuconfig ZMK_STUDIO_HOLDTAP_MUTATION
    bool "AuroraKey: live hold-tap parameter mutation"
    depends on BEHAVIOR_HOLD_TAP
    default n
    help
      Adds get_holdtap_params / set_holdtap_params RPC handlers that
      patch a hold-tap behavior's runtime config (flavor, term, qt,
      prior-idle, htor, position gate). Edits are RAM-only until
      zmk.keymap.save_changes flushes them to NVS.

menuconfig ZMK_STUDIO_MACRO_SLOT_POOL
    bool "AuroraKey: live macro-slot pool"
    depends on ZMK_BEHAVIOR_MACRO
    default n
    help
      Reserves a fixed pool of empty zmk,behavior-slot-macro instances
      at boot. Editor pushes bindings into a slot at runtime via
      list_macro_slots / set_macro_slot, and references the slot from
      a keymap binding (`&slot_macro N`).

if ZMK_STUDIO_MACRO_SLOT_POOL

config ZMK_STUDIO_MACRO_SLOT_COUNT
    int "Slot count"
    default 8
    range 1 32

config ZMK_STUDIO_MACRO_SLOT_BINDINGS_MAX
    int "Max bindings per slot"
    default 64
    range 2 64

endif

menuconfig ZMK_STUDIO_IDLE_DIMMER
    bool "AuroraKey: idle-driven RGB brightness ramp"
    depends on ZMK_RGB_UNDERGLOW
    # Central-only on split keyboards. Peripheral mirrors brightness
    # via the underglow-state split transport (SET_UNDERGLOW_STATE in
    # app/src/split/central.c) — a peripheral-side listener would just
    # fight the central's broadcast.
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    default n
    help
      Smoothly ramps RGB brightness down after CONFIG_ZMK_IDLE_TIMEOUT
      and back up on the next activity event. Layers cleanly with
      CONFIG_ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE: dimmer fires on the same
      ZMK_ACTIVITY_IDLE event and ramps state.color.b toward the floor;
      AUTO_OFF cuts EXT_POWER (LEDs go fully dark). For a "fade-then-
      off" UX, additionally enable AURORAKEY_RGB_AUTO_OFF_DELAY_MS so
      AUTO_OFF waits N ms after the IDLE event before cutting power —
      the dimmer's ramp completes first, then the strip goes dark.
      On wake (ACTIVE event) the chain reverses: AUTO_OFF restores
      EXT_POWER instantly, dimmer ramps brightness back up.

if ZMK_STUDIO_IDLE_DIMMER

config ZMK_STUDIO_IDLE_DIMMER_FLOOR_PCT
    int "Floor brightness (0..100)"
    default 10
    range 0 99

config ZMK_STUDIO_IDLE_DIMMER_RAMP_MS
    int "Ramp duration in ms"
    default 800
    range 100 5000

endif

endif

endif

# AuroraKey: force ZMK to honour the configured Sleep timeout even when
# USB is the active power source. Upstream ZMK gates the SLEEP transition
# on `!is_usb_power_present()` in app/src/activity.c::activity_work_handler
# — useful when wall-powered should mean "always responsive", but
# unhelpful for users on a docked laptop who want battery-saver behaviour
# regardless of plug state, or for testing the sleep path. When this
# option is on, the USB-presence gate is bypassed and Sleep fires after
# CONFIG_ZMK_IDLE_SLEEP_TIMEOUT regardless of power source. Default off
# so vanilla ZMK behaviour stays unchanged unless the workspace's editor
# toggles "Sleep even when USB-powered".
config AURORAKEY_FORCE_SLEEP_ON_USB
    bool "AuroraKey: enforce Sleep timeout even on USB power"
    depends on ZMK_SLEEP
    default n

# AuroraKey: peripheral half never enters deep sleep (sys_poweroff).
# On a split keyboard the peripheral's wake source is its own kscan
# matrix — pressing keys on the central does NOT wake the peripheral
# from system OFF. User types on central → peripheral stays asleep
# forever (until power cycle). The peripheral's MCU draw at idle is
# tiny (~5 mA) and AUTO_OFF still saves the LED power, so skipping
# sys_poweroff on the peripheral is the right tradeoff for split
# keyboards used "asymmetrically" (most typing on one half).
# Default y when ZMK_SLEEP is on AND we're a split keyboard, so the
# peripheral half always stays awake. Central sleep behaviour is
# unchanged. Users who DO want both halves to sleep can untick this
# in the editor (battery use case where the keyboard is unplugged for
# hours and the asymmetric typing is acceptable).
config AURORAKEY_PERIPHERAL_NEVER_SLEEPS
    bool "AuroraKey: peripheral half stays awake even past sleep timeout"
    depends on ZMK_SLEEP && ZMK_SPLIT
    default y

# AuroraKey: optional delay between the ZMK_ACTIVITY_IDLE event firing
# and ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE cutting EXT_POWER. Lets the editor
# expose three independent timeouts:
#   1. CONFIG_ZMK_IDLE_TIMEOUT      — when dimmer ramp starts
#   2. + AURORAKEY_RGB_AUTO_OFF_DELAY_MS — when LEDs cut to off
#   3. CONFIG_ZMK_IDLE_SLEEP_TIMEOUT — when MCU enters deep sleep
# Set to 0 (default) to keep the upstream behaviour where AUTO_OFF cuts
# power immediately on IDLE. Only takes effect when both
# ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE=y and ZMK_RGB_UNDERGLOW=y.
config AURORAKEY_RGB_AUTO_OFF_DELAY_MS
    int "AuroraKey: delay (ms) between IDLE event and RGB cut"
    depends on ZMK_RGB_UNDERGLOW && ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE
    default 0
    range 0 3600000

# AuroraKey: on-keyboard mini-games rendered on the per-key RGB LEDs.
# Each game opt-in via its own bool; the runtime is gated by "any game
# enabled" so the binary stays unchanged when the user hasn't picked
# any. CONFIG_AURORAKEY_GAME_LAYER selects which keymap layer activates
# the game runtime — entering that layer hands the LED buffer + position
# events to the active game; leaving it restores normal keymap dispatch
# and underglow rendering. Central-only — the game state lives on LH and
# pushes per-pixel colours to RH via the existing UPDATE_RGB_COLOR
# split-bt fanout.
menuconfig AURORAKEY_GAMES
    bool "AuroraKey: on-keyboard mini-games on per-key RGB"
    depends on ZMK_RGB_UNDERGLOW && EXPERIMENTAL_RGB_LAYER
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

if AURORAKEY_GAMES

config AURORAKEY_GAME_LAYER
    int "AuroraKey: keymap layer index that activates the game runtime"
    default 4
    range 0 31

config AURORAKEY_GAME_EXIT_POSITION
    int "AuroraKey: matrix position that exits the game and returns to layer 0"
    default 53
    range 0 79
    help
      When a game is active and the user presses this matrix position,
      the runtime exits the game and switches the keymap back to layer
      0. Default 53 = Glove80 LH outer thumb (between start and reset
      on the standard thumb cluster). Other thumb positions used by
      games: 52 (start/pause), 54 (reset), 56/57/72/73 (RH arrows).

config AURORAKEY_GAME_TICK_MS
    int "AuroraKey: default game tick interval (ms)"
    default 200
    range 50 2000

config AURORAKEY_GAME_SNAKE
    bool "AuroraKey: Snake"
    default y

if AURORAKEY_GAME_SNAKE

config AURORAKEY_GAME_SNAKE_TICK_MS
    int "AuroraKey: Snake tick interval (ms) — falls back to GAME_TICK_MS when 0"
    default 200
    range 60 2000

config AURORAKEY_GAME_SNAKE_WRAP
    bool "AuroraKey: Snake wraps around edges (torus topology)"
    default y

config AURORAKEY_GAME_SNAKE_ACCEL_PCT
    int "AuroraKey: Snake speedup percent per food eaten (0 = constant speed)"
    default 0
    range 0 50

endif # AURORAKEY_GAME_SNAKE

config AURORAKEY_GAME_CONWAY
    bool "AuroraKey: Conway's Game of Life (stub for v2)"
    default n

config AURORAKEY_GAME_CONNECT4
    bool "AuroraKey: Connect 4 (stub for v2)"
    default n

endif # AURORAKEY_GAMES
